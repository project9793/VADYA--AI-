<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft glow -->
    <path android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0.55" android:color="#558B5CF6" />
                <item android:offset="1" android:color="#008B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ring, back half -->
    <group android:rotation="-18" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M24,54a30,10 0,0 1,60 0"
            android:strokeColor="#6622D3EE"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>

    <!-- 3D sphere -->
    <path android:pathData="M54,54m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46"
                android:centerY="45"
                android:gradientRadius="36">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.22" android:color="#FF22D3EE" />
                <item android:offset="0.60" android:color="#FF8B5CF6" />
                <item android:offset="1" android:color="#FF1E1B4B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- specular highlight -->
    <path
        android:pathData="M45,39m-5.5,0a5.5,3 0,1 1,11 0a5.5,3 0,1 1,-11 0"
        android:fillColor="#66FFFFFF" />

    <!-- letter V : shadow -->
    <group android:translateX="1" android:translateY="1.6">
        <path
            android:pathData="M41.4,45.6L49,45.6L54,57.8L59,45.6L66.6,45.6L57.2,65.5L50.8,65.5Z"
            android:fillColor="#66141040" />
    </group>
    <!-- letter V -->
    <path android:pathData="M41.4,45.6L49,45.6L54,57.8L59,45.6L66.6,45.6L57.2,65.5L50.8,65.5Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="66">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFBDF3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ring, front half -->
    <group android:rotation="-18" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M24,54a30,10 0,0 0,60 0"
            android:strokeColor="#F222D3EE"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>
</vector>
