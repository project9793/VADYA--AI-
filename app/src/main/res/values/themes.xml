<resources>
    <style name="Theme.VidyaAI" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/vidya_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VidyaAI.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vidya_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VidyaAI</item>
    </style>
</resources>
